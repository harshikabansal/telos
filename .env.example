# TELOS — environment configuration
#
# Copy to .env and adjust. Never commit the real .env: it holds the secret
# that signs every session and reset token.

# --- Required in production -------------------------------------------------

NODE_ENV=production

# Signs session tokens and hashes reset/verification tokens. Must be at least
# 32 characters and unique to this deployment. Changing it signs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TELOS_SECRET=

# The public origin. Used to build reset and verification links, and to
# validate the Origin header on state-changing requests.
TELOS_APP_URL=https://telos.example.com

# --- Server -----------------------------------------------------------------

PORT=4317
HOST=127.0.0.1

# Where the SQLite database and logs live. Back this directory up.
# TELOS_DATA_DIR=/var/lib/telos
# TELOS_DB_FILE=/var/lib/telos/telos.db

# --- Transport security -----------------------------------------------------

# Set when running behind a TLS-terminating reverse proxy, so the real client
# address is read from X-Forwarded-For and HTTPS is detected correctly.
TELOS_TRUST_PROXY=true

# Redirect plain HTTP to HTTPS and send HSTS. On by default in production.
TELOS_FORCE_HTTPS=true

# Adds the Secure attribute to cookies. On by default in production.
TELOS_SECURE_COOKIES=true

# Extra origins permitted to make credentialed cross-origin requests.
# Leave empty unless a separate front-end origin genuinely needs access.
# TELOS_ALLOWED_ORIGINS=https://app.example.com

# --- Sessions and credentials ----------------------------------------------

TELOS_SESSION_TTL_HOURS=12
TELOS_REMEMBER_TTL_DAYS=30
TELOS_SESSION_IDLE_MINUTES=20160
TELOS_MAX_LOGIN_ATTEMPTS=8
TELOS_LOCKOUT_MINUTES=15
TELOS_RESET_TTL_MINUTES=30
TELOS_VERIFY_TTL_HOURS=48

# Never enable in production: it returns reset and verification links in the
# HTTP response so they can be followed without a mail transport.
TELOS_EXPOSE_DEV_TOKENS=false

# --- Mail -------------------------------------------------------------------

# "log"     — write messages to data/outbox.log (default; nothing is sent)
# "webhook" — POST {to, subject, body} to TELOS_EMAIL_WEBHOOK
TELOS_EMAIL_TRANSPORT=log
# TELOS_EMAIL_WEBHOOK=https://mail-relay.example.com/send
# TELOS_EMAIL_WEBHOOK_TOKEN=

# --- Assistant --------------------------------------------------------------
#
# Without a key, the assistant still works: it answers on this server from
# TELOS's own definitions and simple wording rules, and nothing leaves the
# machine. Set a key to offer the richer Claude mode as well — each account
# then chooses it explicitly in Settings → Assistant.
#
# The key is read only by the server. It is never sent to the browser.
# TELOS_ANTHROPIC_API_KEY=sk-ant-...
# TELOS_ASSISTANT_MODEL=claude-opus-5

# --- Optional sign-in providers --------------------------------------------
#
# Providers only appear on the sign-in screen when their client id is present.
# TELOS_GOOGLE_CLIENT_ID=
# TELOS_GOOGLE_CLIENT_SECRET=
# TELOS_APPLE_CLIENT_ID=
# TELOS_APPLE_CLIENT_SECRET=
